# Copy this file to .env.local for local development
# For production, create .env.production or set environment variables directly.
# Set these values to your backend URL for each environment.
# Use either API_URL or the Expo-prefixed variants below.
API_URL=https://api.medtrap.com
EXPO_PUBLIC_API_BASE_URL=https://api.medtrap.com
EXPO_PUBLIC_API_BASE_URL_WEB=https://api.medtrap.com
EXPO_PUBLIC_API_BASE_URL_NATIVE=https://api.medtrap.com
